# Copy this file to .env.local, then fill in your own keys.
# npm start loads .env.local automatically. Never commit it.
SERP_API_KEY=
TYPESAFE_API_KEY=
PORT=3361
HOST=127.0.0.1
# Stop before consuming the last 25 searches in your SerpApi account.
SERP_MONTHLY_RESERVE=25
# Persistent application request caps, not provider spending limits.
FLIGHT_TOTAL_CALL_LIMIT=100
JEV_TOTAL_CALL_LIMIT=100
